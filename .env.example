SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=3306
DB_NAME=garment_store
DB_USERNAME=garment_user
DB_PASSWORD=garment_pass
JWT_SECRET=replace-with-at-least-64-random-characters-for-hmac-signing-production
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
OTP_REGISTRATION_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_EXPOSE_DEV_OTP=true

PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30
PASSWORD_RESET_EXPOSE_DEV_TOKEN=true

GUEST_SESSION_EXPIRY_DAYS=30

ADMIN_LOCKOUT_THRESHOLD=5
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_EMAIL=admin@garmentstore.local
ADMIN_BOOTSTRAP_MOBILE=9999999999
ADMIN_BOOTSTRAP_NAME=Store Admin
ADMIN_BOOTSTRAP_PASSWORD=Admin@12345

# ── Notification Module ─────────────────────────────────────────────────────
# Email (Gmail SMTP)
# 1. Go to: myaccount.google.com → Security → 2-Step Verification → App passwords

# 2. Create an app password → copy the 16-char password here
GMAIL_ADDRESS=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# WhatsApp (Twilio)
# 1. Sign up free at: twilio.com/try-twilio
# 2. Go to Console → WhatsApp → Sandbox → copy credentials
# 3. Send the join phrase to the sandbox number to verify your phone
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Notification settings
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_WHATSAPP_ENABLED=false    # Set to true after Twilio sandbox setup
ADMIN_NOTIFICATION_EMAIL=admin@vastra.in
ADMIN_NOTIFICATION_WHATSAPP=+919876543210   # Admin WhatsApp (E.164 format)
LOW_STOCK_THRESHOLD=5
